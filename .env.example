# ═══════════════════════════════════════════════════════════════════════════
# TradeFlow AI — Environment Variables Template
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-at-least-32-chars-long-here

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Database (Supabase local) ─────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=http://localhost:5000
# Dev keys — safe to commit (from supabase/supabase repo)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7ACcEmkigg7jf-5j2kwkMVQmog4B5-enGpk
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=tradeflow
KEYCLOAK_CLIENT_ID=tradeflow-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Next.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-32-chars-long-minimum!!
KEYCLOAK_ISSUER=http://localhost:8080/realms/tradeflow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=minio
STORAGE_BUCKET_NAME=tradeflow-documents

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8002

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Required — Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_PRIMARY=gemini-2.0-flash-exp
GEMINI_MODEL_FALLBACK=gemini-1.5-flash
COST_SAVING_MODE=false

# Required — Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (optional but recommended for debugging)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tradeflow-ai
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ── Azure Document Intelligence (Fallback OCR) ────────────────────────────────
# Optional — only needed if primary OCR pipeline fails frequently
ENABLE_AZURE_DI_FALLBACK=false
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-di-key-here

# ── Blockchain ────────────────────────────────────────────────────────────────
# Set to false to disable blockchain anchoring in dev
ENABLE_BLOCKCHAIN=false
# NEVER commit private keys — use secrets management in production
BLOCKCHAIN_PRIVATE_KEY=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_POS_RPC_URL=https://polygon-rpc.com
CONTRACT_ADDRESS=

# IPFS via Pinata (optional)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
# Get from https://resend.com
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@tradeflow.ai

# WhatsApp Business API (optional)
ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_ADAPTIVE_LEARNING=true
CRS_MIN_SUBMIT_THRESHOLD=70.0
OCR_FALLBACK_TRIGGER_CONFIDENCE=0.78
HS_CODE_CONFIDENCE_THRESHOLD=0.75

# ── CEISA ─────────────────────────────────────────────────────────────────────
# Dev: simulator. Staging/prod: real DJBC endpoint
CEISA_BASE_URL=http://localhost:8001
# AES-256-GCM key for payload encryption (base64). Generate:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CEISA_AES_KEY=

# ── Realtime encryption key (Supabase) ────────────────────────────────────────
REALTIME_ENC_KEY=supabase_realtime_dev_key
REALTIME_SECRET_KEY_BASE=EArlQos5yiMGxnCFsxY3ej1cjVObPKpfFc0MNhyP+tNRGJQ4MVtbzOFYHSlxdAHE
