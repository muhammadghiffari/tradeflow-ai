# ═══════════════════════════════════════════════════════════════════════════
# TradeFlow AI — Environment Variables Template (v5.2)
# Copy to .env and fill in required values.
# NEVER commit .env to version control.
# All variables consumed through apps/api/src/config.py (pydantic-settings).
# PRD Invariant #3: No bare os.getenv() anywhere in the codebase.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-at-least-32-chars-long-here

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Database (single postgres service) ───────────────────────────────────────
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# ── Supabase (used for Realtime subscriptions — anon key safe to expose in frontend)
SUPABASE_URL=http://localhost:5432
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── Keycloak 26 — SOLE auth provider (Invariant #4) ──────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-all-environments
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=tradeflow
KEYCLOAK_CLIENT_ID=tradeflow-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ISSUER=http://localhost:8080/realms/tradeflow

# Next.js / NextAuth (web service)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-32-chars-long-minimum!!
KEYCLOAK_WEB_CLIENT_ID=tradeflow-web
KEYCLOAK_WEB_CLIENT_SECRET=change-me-in-production

# ── Redis 8 ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RUN_OCR_IN_API_BACKGROUND=false

# ── AI Inference Services ─────────────────────────────────────────────────────
# Service URLs (overridden in docker-compose to use container names)
SURYA_INFERENCE_URL=http://localhost:8010
OLM_INFERENCE_URL=http://localhost:8000
PADDLEOCR_SVC_URL=http://localhost:8011
MINERU_SVC_URL=http://localhost:8012

# HuggingFace (for model download at container startup — Invariant #5)
HF_TOKEN=hf_your_huggingface_read_token
OLM_BASE_MODEL=allenai/olmOCR-2-7B-1025
OLM_LORA_ADAPTER=muhammadghiffari/olm-ocr-cipl-v1

# ── ChromaDB — HS Code vector store ──────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8002

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Required — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Optional: OpenAI embeddings
OPENAI_API_KEY=
AZURE_DI_MODEL_ID=prebuilt-read
EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (optional, recommended for debugging agent traces)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tradeflow-ai
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ── Azure Document Intelligence — Agent C ─────────────────────────────────────
# F0 free tier: 5000 pages/month. Set to empty to disable Agent C.
# Invariant #9: Track quota — AZURE_DI_FREE_LIMIT=5000 defined in config.py
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-di-key-here

# ── CEISA 4.0 ─────────────────────────────────────────────────────────────────
# Dev: simulator on port 8006. Staging/prod: real DJBC endpoint
CEISA_BASE_URL=http://localhost:8006
CEISA_CLIENT_ID=your-ceisa-client-id
CEISA_CLIENT_SECRET=your-ceisa-client-secret
# AES-256-GCM key for payload encryption (base64). Generate:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CEISA_AES_KEY=
CEISA_REQUEST_TIMEOUT_SECONDS=30
CEISA_POLL_INTERVAL_SECONDS=30

# ── Blockchain ────────────────────────────────────────────────────────────────
ENABLE_BLOCKCHAIN=false
# NEVER commit private keys — use secrets management in production
OPERATOR_WALLET_PRIVATE_KEY=
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
# IPFS via Pinata
PINATA_JWT=

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@tradeflow.ai
ENABLE_NOTIFICATIONS_WHATSAPP=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_SURYA_AGENT=true
ENABLE_AZURE_DI_AGENT=true
ENABLE_VESSEL_VALIDATION=true
ENABLE_INSW_CHECK=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_AI_COPILOT=true
ENABLE_HS_RAG=true
ENABLE_REJECTION_PREDICTION=true
ENABLE_STATUS_POLLING=true

# ── Thresholds ────────────────────────────────────────────────────────────────
OCR_FAST_PATH_QUALITY_THRESHOLD=0.95
OCR_PDF_TEXT_MIN_CHARS=250
OCR_PDF_TEXT_MIN_CHARS_PER_PAGE=80
CRS_MIN_SUBMIT_THRESHOLD=55
HS_CONFIDENCE_RAG_THRESHOLD=0.75
REJECTION_RISK_BLOCK_THRESHOLD=0.70
MAX_RESUBMIT_ATTEMPTS=5

# ── Paths ─────────────────────────────────────────────────────────────────────
VALIDATION_RULES_PATH=packages/db/validation_rules.json
CARRIER_PROFILES_PATH=packages/db/carrier_profiles.json
